{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat installDebug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Run Mobile App (Install & Launch)",
            "type": "shell",
            "command": "adb shell monkey -p com.smartsolar.microgrid -c android.intent.category.LAUNCHER 1",
            "dependsOn": "Install Debug APK",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gradle"]
        }
    ]
}
