<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent"
                android:contentDescription="Settings" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Server Connection"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Configure backend REST API endpoint for USB cable, Hotspot, or Wi-Fi mode."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Presets Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="QUICK PRESETS"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Row 1: USB 5299 and USB 8000 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetUsb5299"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="44dp"
                android:background="@drawable/btn_preset_chip"
                app:backgroundTint="@null"
                android:paddingVertical="10dp"
                android:paddingHorizontal="8dp"
                android:text="USB (5299)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetUsb8000"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="44dp"
                android:background="@drawable/btn_preset_chip"
                app:backgroundTint="@null"
                android:paddingVertical="10dp"
                android:paddingHorizontal="8dp"
                android:text="USB (8000)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Wi-Fi/Hotspot and Emulator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="44dp"
                android:background="@drawable/btn_preset_chip"
                app:backgroundTint="@null"
                android:paddingVertical="10dp"
                android:paddingHorizontal="8dp"
                android:text="Wi-Fi / Hotspot"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetEmulator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="44dp"
                android:background="@drawable/btn_preset_chip"
                app:backgroundTint="@null"
                android:paddingVertical="10dp"
                android:paddingHorizontal="8dp"
                android:text="Emulator (10.0.2.2)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Server URL Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="BACKEND BASE URL"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_bg"
            android:hint="e.g. 10.97.165.17:5299 or 127.0.0.1:5299"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFormattedPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Formats to: http://127.0.0.1:5299/api/"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <!-- Test Connection Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/rounded_button"
                app:backgroundTint="@null"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="⚡ Test Connection"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbTesting"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Test Result Indicator -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="42dp"
            android:gravity="center_vertical"
            android:background="@drawable/edit_text_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="● Status: Not tested yet"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Dialog Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:background="@drawable/rounded_button"
                app:backgroundTint="@null"
                android:paddingHorizontal="22dp"
                android:paddingVertical="10dp"
                android:text="Save &amp; Apply"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
