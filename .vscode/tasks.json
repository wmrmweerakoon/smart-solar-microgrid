{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Mobile App on Emulator (1-Click)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\run-emulator.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Mobile App on Phone (1-Click)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\run-phone.ps1",
            "problemMatcher": []
        },
        {
            "label": "Connect Emulator to Backend (adb reverse)",
            "type": "shell",
            "command": "adb -e reverse tcp:5299 tcp:5299",
            "problemMatcher": []
        },
        {
            "label": "Connect Phone to Backend (adb reverse)",
            "type": "shell",
            "command": "adb -d reverse tcp:5299 tcp:5299",
            "problemMatcher": []
        },
        {
            "label": "Build Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "options": {
                "cwd": "${workspaceFolder}/mobile"
            },
            "problemMatcher": ["$gradle"]
        }
    ]
}
